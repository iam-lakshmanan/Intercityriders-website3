# Browser key: Maps JavaScript + Places; restrict it to your website origins.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key: Directions API; keep this private and restrict it to your server.
GOOGLE_MAPS_SERVER_API_KEY=
# At least 32 random characters, server-only.
QUOTE_SIGNING_SECRET=
# Server-only booking delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Replace with your verified public business details before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PHONE=+919944942223
NEXT_PUBLIC_EMAIL=info@onewaytaxi.com
# Configure only behind a reverse proxy that overwrites this header.
TRUSTED_IP_HEADER=
