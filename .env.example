# Required: browser Maps JavaScript + Places key; restrict it to your website origins.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: enables automatic signed fare estimates. Booking requests still work without these.
# Keep the Directions key private and restrict it to your server.
GOOGLE_MAPS_SERVER_API_KEY=
# At least 32 random characters, server-only.
QUOTE_SIGNING_SECRET=
# Required: server-only booking delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Replace with your verified public business details before deployment.
NEXT_PUBLIC_SITE_URL=https://onewaydroptaxis.com
NEXT_PUBLIC_PHONE=+919944942223
NEXT_PUBLIC_EMAIL=info@onewaytaxi.com
# Configure only behind a reverse proxy that overwrites this header.
TRUSTED_IP_HEADER=
