# Required: Maps JavaScript, Places and Directions key used for route previews and fare estimates.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional production overrides. When omitted, the Maps key above is used for Directions and
# TELEGRAM_BOT_TOKEN is used as the server-only quote-signing secret.
GOOGLE_MAPS_SERVER_API_KEY=
# At least 32 random characters, server-only. Recommended when you want a separately rotated key.
QUOTE_SIGNING_SECRET=
# Required: server-only booking delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Replace with your verified public business details before deployment.
NEXT_PUBLIC_SITE_URL=https://onewaydroptaxis.com
NEXT_PUBLIC_PHONE=+919944942223
NEXT_PUBLIC_EMAIL=info@onewaytaxi.com
# Configure only behind a reverse proxy that overwrites this header.
TRUSTED_IP_HEADER=
